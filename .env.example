# Supabase — get from https://app.supabase.com/project/<project>/settings/api
# Public (safe to expose in browser, Vite will bake VITE_ vars at build time)
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# Server-only — never expose, no VITE_ prefix
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<key>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<key>
# Legacy JWT secret (only if using old JWT verification, otherwise use service_role)
SUPABASE_JWT_SECRET=<from Dashboard → Settings → API → JWT Settings → JWT Secret>

# MongoDB Atlas — get from Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/kairo

# Express
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
# For production, set to your Vercel frontend domain, e.g., https://kairo.vercel.app
# FRONTEND_URL=https://<your-vercel-app>.vercel.app

# Guest auth — generate via: openssl rand -hex 32
GUEST_JWT_SECRET=<random 32-byte hex>

# AI Tutor — set at least ONE of these (server/lib/gemini.cjs will try in order: Gemini → OpenRouter → Groq → Claude → mock)
# If you only have OpenRouter, just set OPENROUTER_API_KEY and leave GEMINI_API_KEY empty — the tutor will work via OpenRouter.
GEMINI_API_KEY=<your_gemini_api_key>  # from https://aistudio.google.com/app/apikey  (primary)
OPENROUTER_API_KEY=<your_openrouter_key>  # from https://openrouter.ai/keys  (fallback, or primary if Gemini empty)
GROQ_API_KEY=<your_groq_key>  # optional
CLAUDE_API_KEY=<your_claude_key>  # optional
ANTHROPIC_API_KEY=<same_as_claude>  # optional alias

# Supabase Edge Function (set via: supabase secrets set)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b
SITE_URL=http://localhost:8080

# HuggingFace (for pronunciation ASR + OCR TrOCR) — optional, pronunciation/OCR will return 503 if not set
HF_API_TOKEN=<your_hf_token>
HF_JA_ASR_MODEL=kotoba-tech/kotoba-whisper-v2.0
HF_OCR_MODEL=microsoft/trocr-base-printed

# Firebase (client-safe, but keep out of version control)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Frontend API (Vite will replace at build time)
VITE_API_BASE_URL=http://localhost:4000
# For production build, set to your Render backend URL
# VITE_API_BASE_URL=https://<your-render-service>.onrender.com

# Security — set to true to allow insecure JWT decode fallback in dev (NEVER in production)
# ALLOW_INSECURE_AUTH=false
